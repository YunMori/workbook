; /etc/systemd/system/workbook.service 로 복사한 뒤
;   sudo systemctl daemon-reload && sudo systemctl enable --now workbook

[Unit]
Description=SSAFY 문제집 gunicorn
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/srv/workbook/backend
; /run/workbook 을 systemd가 만들고 종료 시 정리한다
RuntimeDirectory=workbook
ExecStart=/srv/workbook/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 \
    --bind unix:/run/workbook/gunicorn.sock \
    --umask 007 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
