# 배포 서버의 backend/.env 로 복사해서 값을 채운다. (chmod 600)
# 이 파일이 없으면 settings.py의 개발용 기본값으로 동작한다 — 로컬에서는 만들 필요 없다.

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=0

# 접속에 쓰는 주소. EC2 탄력적 IP 또는 도메인. 쉼표로 여러 개.
ALLOWED_HOSTS=

# admin 로그인 폼이 거부되지 않도록 스킴까지 적는다. 예: http://12.34.56.78
CSRF_TRUSTED_ORIGINS=

# HTTPS를 붙인 뒤에 1로 바꾼다. HTTP 상태에서 켜면 접속이 무한 리다이렉트된다.
SECURE_SSL=0
